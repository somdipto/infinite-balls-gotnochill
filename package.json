{
  "name": "infinite-balls-gotnochill",
  "version": "0.1.0",
  "description": "Local API credential proxy and bounded Harness2-inspired browser harness improvement",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "bin": { "skill": "bin/skill.mjs" },
  "files": ["bin", "dist", "platforms", "SKILL.md", "README.md", "docs", "skill.config.yaml"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke": "node --import tsx mock/smoke.ts",
    "browser-smoke": "node --import tsx mock/run-browser.ts",
    "package-smoke": "node --import tsx mock/package-smoke.ts",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build && npm run smoke",
    "prepack": "npm run build"
  },
  "dependencies": { "playwright": "1.65.0", "proper-lockfile": "^4.1.2", "yaml": "^2.8.1", "zod": "^3.24.0" },
  "devDependencies": { "@types/node": "^22.10.0", "@types/proper-lockfile": "^4.1.4", "eslint": "^9.14.0", "tsx": "^4.20.0", "typescript": "^5.7.0", "typescript-eslint": "^8.14.0" },
  "repository": { "type": "git", "url": "https://github.com/somdipto/infinite-balls-gotnochill.git" }
}
